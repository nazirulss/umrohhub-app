<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00AA5B" />
      <stop offset="100%" stop-color="#005B31" />
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE68A" />
      <stop offset="50%" stop-color="#D97706" />
      <stop offset="100%" stop-color="#B45309" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.3"/>
    </filter>
  </defs>
  
  <!-- Rounded Base Background -->
  <rect width="512" height="512" rx="120" fill="url(#bg)" />
  
  <!-- Gold Halo / Ring -->
  <circle cx="256" cy="256" r="190" fill="none" stroke="url(#gold)" stroke-width="8" opacity="0.4" />
  
  <!-- Stylized Ka'bah Cube Icon -->
  <g filter="url(#shadow)" transform="translate(0, -10)">
    <!-- Main Cube Body -->
    <rect x="146" y="146" width="220" height="230" rx="24" fill="#18181B" stroke="#27272A" stroke-width="6"/>
    
    <!-- Gold Kiswah Band Top -->
    <path d="M146 195 H366" stroke="url(#gold)" stroke-width="26" stroke-linecap="square"/>
    <path d="M146 220 H366" stroke="url(#gold)" stroke-width="6" stroke-linecap="square"/>
    
    <!-- Golden Door / Bab Al-Kaaba -->
    <rect x="275" y="245" width="60" height="110" rx="10" fill="url(#gold)" />
    <path d="M305 245 V355" stroke="#92400E" stroke-width="3"/>
    
    <!-- Golden Crescent Moon on Top Right -->
    <path d="M340 100 A 30 30 0 1 1 310 135 A 24 24 0 1 0 340 100 Z" fill="url(#gold)"/>
  </g>
  
  <!-- App Name Wordmark Sub-text -->
  <text x="256" y="445" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="800" font-size="44" fill="#FFFFFF" text-anchor="middle" letter-spacing="1">UMROHPEDIA</text>
</svg>
